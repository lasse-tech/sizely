{
    "head-general": {
        "type": "header",
        "description": "General"
    },
    "size-unit": {
        "type": "combobox",
        "default": "logical",
        "description": "Unit for all sizes",
        "tooltip": "Logical: sizes are multiplied by the UI scaling factor, so \"1920 x 1080\" covers the same area a Full HD screen would. Physical: raw screen pixels.",
        "options": {
            "Logical pixels (HiDPI-scaled)": "logical",
            "Physical pixels": "physical"
        }
    },
    "use-submenu": {
        "type": "checkbox",
        "default": true,
        "description": "Group presets in a \"Size\" submenu",
        "tooltip": "When off, every preset is shown directly in the window menu."
    },
    "show-center-item": {
        "type": "checkbox",
        "default": true,
        "description": "Show \"Center on Monitor\" in the window menu"
    },
    "show-in-window-menu": {
        "type": "checkbox",
        "default": true,
        "description": "Extend the window menu (right-click on the title bar)",
        "tooltip": "When off, only the keyboard shortcuts are active."
    },
    "head-center": {
        "type": "header",
        "description": "Centering"
    },
    "center-keybinding": {
        "type": "keybinding",
        "default": "<Super><Shift>c",
        "description": "Shortcut for \"Center on Monitor\"",
        "tooltip": "Centers the focused window on the monitor it currently sits on, without changing its size."
    },
    "head-presets": {
        "type": "header",
        "description": "Your presets"
    },
    "presets-hint": {
        "type": "label",
        "description": "Every row becomes a menu entry. \"Center\" places the window in the middle of the current monitor after resizing. The shortcut is optional."
    },
    "presets": {
        "type": "list",
        "description": "Presets",
        "columns": [
            {
                "id": "label",
                "title": "Name",
                "type": "string"
            },
            {
                "id": "width",
                "title": "Width",
                "type": "integer",
                "default": 1280,
                "min": 100,
                "max": 32768,
                "align": 1.0
            },
            {
                "id": "height",
                "title": "Height",
                "type": "integer",
                "default": 800,
                "min": 100,
                "max": 32768,
                "align": 1.0
            },
            {
                "id": "center",
                "title": "Center",
                "type": "boolean",
                "default": false
            },
            {
                "id": "keybinding",
                "title": "Shortcut",
                "type": "keybinding"
            }
        ],
        "default": [
            {
                "label": "Small  1280 × 800",
                "width": 1280,
                "height": 800,
                "center": false,
                "keybinding": ""
            },
            {
                "label": "Medium  1600 × 1000",
                "width": 1600,
                "height": 1000,
                "center": false,
                "keybinding": ""
            },
            {
                "label": "Large  1920 × 1200",
                "width": 1920,
                "height": 1200,
                "center": false,
                "keybinding": ""
            }
        ]
    },
    "head-standard": {
        "type": "header",
        "description": "Standard resolutions"
    },
    "standard-hint": {
        "type": "label",
        "description": "A built-in list of common display resolutions, grouped by aspect ratio. They follow the unit setting above."
    },
    "show-standard-resolutions": {
        "type": "checkbox",
        "default": true,
        "description": "Show the \"Standard resolutions\" submenu"
    },
    "standard-center": {
        "type": "checkbox",
        "default": false,
        "description": "Center the window after picking a standard resolution",
        "dependency": "show-standard-resolutions"
    },
    "standard-fit-only": {
        "type": "checkbox",
        "default": true,
        "description": "Only list resolutions that fit on the current monitor",
        "tooltip": "Resolutions larger than the monitor's work area would just be clamped to it, so they are hidden by default. The check uses the scaled size.",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-16-9": {
        "type": "checkbox",
        "default": true,
        "description": "16:9",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-16-10": {
        "type": "checkbox",
        "default": true,
        "description": "16:10",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-4-3": {
        "type": "checkbox",
        "default": false,
        "description": "4:3 / 5:4",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-21-9": {
        "type": "checkbox",
        "default": false,
        "description": "21:9",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-32-9": {
        "type": "checkbox",
        "default": false,
        "description": "32:9",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-dci": {
        "type": "checkbox",
        "default": false,
        "description": "Digital Cinema",
        "dependency": "show-standard-resolutions"
    }
}
