{
    "layout": {
        "type": "layout",
        "pages": [
            "generalPage",
            "presetsPage",
            "standardPage",
            "aboutPage"
        ],
        "generalPage": {
            "type": "page",
            "title": "General",
            "sections": [
                "menuSection",
                "sizeSection",
                "resizeSection",
                "shortcutSection"
            ]
        },
        "presetsPage": {
            "type": "page",
            "title": "Custom Sizes",
            "sections": [
                "presetsSection"
            ]
        },
        "standardPage": {
            "type": "page",
            "title": "Standard Resolutions",
            "sections": [
                "standardSection",
                "ratioSection"
            ]
        },
        "aboutPage": {
            "type": "page",
            "title": "About",
            "sections": [
                "aboutSection"
            ]
        },
        "menuSection": {
            "type": "section",
            "title": "Window menu",
            "keys": [
                "show-in-window-menu",
                "use-submenu",
                "show-center-item"
            ]
        },
        "sizeSection": {
            "type": "section",
            "title": "Sizes",
            "keys": [
                "size-unit"
            ]
        },
        "resizeSection": {
            "type": "section",
            "title": "Resizing",
            "keys": [
                "show-resize-label"
            ]
        },
        "shortcutSection": {
            "type": "section",
            "title": "Keyboard shortcut",
            "keys": [
                "center-keybinding"
            ]
        },
        "presetsSection": {
            "type": "section",
            "title": "Custom sizes",
            "keys": [
                "presets"
            ]
        },
        "standardSection": {
            "type": "section",
            "title": "Display",
            "keys": [
                "show-standard-resolutions",
                "standard-center",
                "standard-fit-only"
            ]
        },
        "ratioSection": {
            "type": "section",
            "title": "Aspect ratios",
            "keys": [
                "standard-family-16-9",
                "standard-family-16-10",
                "standard-family-4-3",
                "standard-family-21-9",
                "standard-family-32-9",
                "standard-family-phones",
                "standard-family-dci"
            ]
        },
        "aboutSection": {
            "type": "section",
            "title": "Sizely",
            "keys": [
                "about-version",
                "about-copyright",
                "about-license",
                "about-chip"
            ]
        }
    },
    "size-unit": {
        "type": "combobox",
        "default": "logical",
        "description": "Unit for all sizes",
        "options": {
            "Logical pixels (HiDPI-scaled)": "logical",
            "Physical pixels": "physical"
        }
    },
    "use-submenu": {
        "type": "checkbox",
        "default": true,
        "description": "Custom sizes in a \"Size\" submenu"
    },
    "show-center-item": {
        "type": "checkbox",
        "default": true,
        "description": "\"Center on Monitor\" in the window menu"
    },
    "show-in-window-menu": {
        "type": "checkbox",
        "default": true,
        "description": "Entries in the window menu"
    },
    "show-resize-label": {
        "type": "checkbox",
        "default": true,
        "description": "Size while resizing"
    },
    "center-keybinding": {
        "type": "keybinding",
        "default": "<Super><Shift>c",
        "description": "Center on Monitor"
    },
    "presets": {
        "type": "list",
        "description": "Custom sizes",
        "columns": [
            {
                "id": "label",
                "title": "Name",
                "type": "string"
            },
            {
                "id": "width",
                "title": "Width",
                "type": "integer",
                "default": 1280,
                "min": 100,
                "max": 32768,
                "align": 1.0
            },
            {
                "id": "height",
                "title": "Height",
                "type": "integer",
                "default": 800,
                "min": 100,
                "max": 32768,
                "align": 1.0
            },
            {
                "id": "center",
                "title": "Center",
                "type": "boolean",
                "default": false
            }
        ],
        "default": [
            {
                "label": "Small  1280 × 800",
                "width": 1280,
                "height": 800,
                "center": false
            },
            {
                "label": "Medium  1600 × 1000",
                "width": 1600,
                "height": 1000,
                "center": false
            },
            {
                "label": "Large  1920 × 1200",
                "width": 1920,
                "height": 1200,
                "center": false
            }
        ]
    },
    "show-standard-resolutions": {
        "type": "checkbox",
        "default": true,
        "description": "\"Standard Resolutions\" submenu"
    },
    "standard-center": {
        "type": "checkbox",
        "default": false,
        "description": "Center after resizing",
        "dependency": "show-standard-resolutions"
    },
    "standard-fit-only": {
        "type": "checkbox",
        "default": true,
        "description": "Only sizes that fit the monitor",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-16-9": {
        "type": "checkbox",
        "default": true,
        "description": "16:9",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-16-10": {
        "type": "checkbox",
        "default": true,
        "description": "16:10",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-4-3": {
        "type": "checkbox",
        "default": false,
        "description": "4:3 / 5:4",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-21-9": {
        "type": "checkbox",
        "default": false,
        "description": "21:9",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-32-9": {
        "type": "checkbox",
        "default": false,
        "description": "32:9",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-phones": {
        "type": "checkbox",
        "default": true,
        "description": "Phones (CSS viewports)",
        "dependency": "show-standard-resolutions"
    },
    "standard-family-dci": {
        "type": "checkbox",
        "default": false,
        "description": "Digital Cinema",
        "dependency": "show-standard-resolutions"
    },
    "about-version": {
        "type": "label",
        "description": "Version 1.0.0"
    },
    "about-copyright": {
        "type": "label",
        "description": "© 2026 Lars Gossard"
    },
    "about-license": {
        "type": "label",
        "description": "MIT License"
    },
    "about-chip": {
        "type": "label",
        "description": "Made with <3 in Europe"
    }
}
